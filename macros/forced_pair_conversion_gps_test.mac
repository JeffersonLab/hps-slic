# Smoke test for the ForcedPairConversion plugin using a particle gun
# instead of real WAB stdhep input, to verify the plugin loads, fires,
# finds module_L1 in the real v10-dev detector geometry, and forces a
# conversion with a sensible weight.
#
# Note: in this detector's LCDD frame the beam/downstream axis is +y.
# A single-event tracking-verbose check confirmed a 2 GeV photon fired
# from the origin along +y passes through base_volume then
# support_plate_top_L14_volume before reaching the tracking volume and
# module_L1 (further downstream) -- natural conversion can happen
# upstream of module_L1 too, which the plugin correctly detects and
# skips (hasConverted_ latch). High statistics needed so some photons
# survive un-converted all the way to module_L1 for the forcing logic
# to actually fire.

/lcdd/url /sdf/group/hps/users/mgraham/MCProduction/2021/hps-java-v5.3.1-lowp-bugfix/detector-data/detectors/HPS_Run2021Pass1_v10-dev_14272/HPS_Run2021Pass1_v10-dev_14272.lcdd

/run/initialize

/generator/select gps
/gps/particle gamma
/gps/energy 2 GeV
/gps/pos/type Point
/gps/pos/centre 0 0 0 mm
/gps/direction 0 1 0

/slic/plugins/load ForcedPairConversion

/lcio/filename forced_pair_conversion_gps_test.slcio
/lcio/fileExists delete

/run/beamOn 20000
